# Server Configuration
PORT=3000
NODE_ENV=development

# Path Configuration (Runtime)
BASE_PATH=/
BASE_URL=http://localhost:3000

# Content Storage
STORAGE_ADAPTER=fs
SCAN_DIRS=/data/docs
WRITE_DIR=/data/docs
CONTENT_WATCHER=true
# Set to a value (ms) to poll for changes when file events are unreliable (e.g. Docker on macOS)
CONTENT_WATCH_POLL_MS=1000

# Features
ALLOW_INDEXING=false

# S3 Storage (Optional)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BASE_PREFIX=uploads
